    "decoder_transformer": "ProjectedTransformer(device=\"cpu\", d_model=512, num_heads=8, num_layers=8, causal=True, layer_scale=0.01, context=250, conv_layout=True, max_period=10000, gating=\"none\", norm=\"layer_norm\", positional_embedding=\"rope\", dim_feedforward=2048, input_dimension=512, output_dimensions=[512]); load only decoder_transformer.* after stripping prefix, strict=True",
