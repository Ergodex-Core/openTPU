// Source-linked metadata synthesis regression; generated by tools/c2_metadata_synth_regression.py.
module metadata_repro #(parameter integer C=4,RF=8,LROW=25,EP=12)(
 input logic clk,rst,accept,fill_bank,compute_bank,read_advance,
 input logic cmd_decode,cmd_acc,input logic [31:0] cmd_tag,
 input logic [C-1:0] cmd_mask,input logic [C-1:0][31:0] cmd_addr,
 input logic [C-1:0][47:0] integers,input logic [C-1:0][31:0] tail_sw,tail_sa,
 input logic out_ready,old_valid,input logic [31:0] cfg_rows,
 output wire out_valid,output wire [165:0] out_meta,
 output wire [C-1:0][47:0] out_integer,
 output wire [C-1:0][31:0] out_sw,out_sa,
 output logic [31:0] result_count,output logic done,
 output wire [3:0] fifo_level);
 localparam integer FW=$clog2(RF);
@TYPES@
 meta_t command, command_bank[2],tail_meta,emeta;
@FIFO_DECLARATION@
 logic fetch_valid,last0;
 logic [LROW-1:0] row_valid;
 logic [EP-1:0] ev;
 logic [FW-1:0] rh,rt;
 logic [FW:0] rn;
 wire pf_advance=fetch_valid;
 wire push=row_valid[LROW-1];
@FIFO_READ@
 wire epi_en=!out_valid || out_ready;
 wire pop=epi_en && rn!=0 && (!head.meta.acc || old_valid);
 @META_DELAY@
 @EMETA_DELAY@
 otpu_delay #(.W(C*48),.N(EP)) u_ex(.clk,.en(epi_en),.d(head.x),.q(out_integer));
 otpu_delay #(.W(C*32),.N(EP)) u_sw(.clk,.en(epi_en),.d(head.sw),.q(out_sw));
 otpu_delay #(.W(C*32),.N(EP)) u_sa(.clk,.en(epi_en),.d(head.sa),.q(out_sa));
 assign out_valid=ev[EP-1];assign out_meta=emeta;assign fifo_level=rn;
 always_ff @(posedge clk)begin
  if(rst)begin
   fetch_valid<=0;last0<=0;command<='0;
   for(int b=0;b<2;b++)command_bank[b]<='0;
   rn<=0;rh<=0;rt<=0;row_valid<='0;ev<='0;
   result_count<=0;done<=0;
  end else begin
   fetch_valid<=read_advance;
   if(read_advance)begin command<=command_bank[compute_bank];last0<=1'b1;end
   row_valid<={row_valid[LROW-2:0],pf_advance && last0};
   if(epi_en)ev<={ev[EP-2:0],pop};
   if(accept)command_bank[fill_bank]<='{decode:cmd_decode,acc:cmd_acc,tag:cmd_tag,mask:cmd_mask,addr:cmd_addr};
   if(push)begin @FIFO_WRITE@rt<=rt+1'b1;end
   if(pop)rh<=rh+1'b1;
   case({push,pop})2'b10:rn<=rn+1'b1;2'b01:rn<=rn-1'b1;default:;endcase
   if(out_valid&&out_ready)begin
    result_count<=result_count+$countones(emeta.mask);
    if(result_count+$countones(emeta.mask)==cfg_rows)done<=1;
   end
  end
 end
endmodule

// Faithful observability: acc is tied0, old_valid0, addr and acc outputs unused.
// Only mask/decode/tag uses present in kernel retirement/result-write logic remain.
module metadata_faithful(input logic clk,rst,accept,fill_bank,compute_bank,read_advance,
 input logic cmd_decode,input logic[31:0]cmd_tag,input logic[3:0]cmd_mask,
 input logic[191:0]integers,input logic[127:0]tail_sw,tail_sa,
 input logic out_ready,input logic[31:0]cfg_rows,
 output wire out_valid,output wire[3:0]result_write,output wire[7:0]result_addr,
 output wire[191:0]out_integer,output wire[127:0]out_sw,out_sa,
 output wire[31:0]result_count,output wire done,output wire[3:0]fifo_level);
 wire[165:0]metadata;
 wire[3:0]effective_mask=cmd_decode?cmd_mask:4'b0001;
 wire[127:0]cmd_addr;
 for(genvar c=0;c<4;c++)begin:addrgen
  assign cmd_addr[c*32+:32]=cmd_tag+(cmd_decode?32'(c):32'd0);
  assign result_write[c]=out_valid&&out_ready&&(metadata[165]?metadata[128+c]:(metadata[133:132]==2'(c)));
 end
 assign result_addr=metadata[141:134];
 metadata_repro u_path(.clk,.rst,.accept,.fill_bank,.compute_bank,.read_advance,
 .cmd_decode,.cmd_acc(1'b0),.cmd_tag,.cmd_mask(effective_mask),.cmd_addr,
 .integers,.tail_sw,.tail_sa,.out_ready,.old_valid(1'b0),.cfg_rows,
 .out_valid,.out_meta(metadata),.out_integer,.out_sw,.out_sa,.result_count,.done,.fifo_level);
endmodule
