# The channels' SmartConnects' instance in cl_opentpu_hbm.sv, written from the generated block
# design wrapper's own port list (create_hbm_sc.tcl sources this file; tests/test_f2_build.py
# runs it under tclsh on a sample wrapper). Every wrapper port is mapped to the CL's signals:
#   S_N<p>_<sig>  -> cs_<sig>[p]      (channel p's 512-bit register slice, AXI4 at the core clock)
#   M_H<p>_<sig>  -> cm_<sig>[p]      (channel p's 256-bit register slice, AXI3 at 450 MHz)
#   clocks / resets                    core_clk clk, hbm_clk hclk, aresetn sc_aresetn
# Addresses and IDs adapt to the wrapper's widths (an input zero-extended or cut, an output
# through a wire of its own width: the SmartConnect's settings are cl_axi_sc_1x1's, its AXI4
# side 64-bit addresses, the CL's slices' 64 / 34); every other width must be the CL's. The
# protocol's optional inputs (lock, cache, prot, qos, region, user) are tied to 0, its optional
# outputs left open; an AXI3-side ID the wrapper lacks is tied to 0 (cm_awid / cm_arid: AWS's
# cl_axi_sc_1x1 has none). Fail closed: an input the CL does not know, a data width other than
# the CL's, or a port the CL needs missing stops the build.

proc otpu_sc_widths {} {
  return {
    C {awid 16 awaddr 64 awlen 8 awsize 3 awburst 2 awvalid 1 awready 1 wdata 512 wstrb 64
       wlast 1 wvalid 1 wready 1 bid 16 bresp 2 bvalid 1 bready 1 arid 16 araddr 64 arlen 8
       arsize 3 arburst 2 arvalid 1 arready 1 rid 16 rdata 512 rresp 2 rlast 1 rvalid 1 rready 1}
    X {awaddr 34 awlen 4 awsize 3 awburst 2 awvalid 1 awready 1 wdata 256 wstrb 32 wlast 1
       wvalid 1 wready 1 bresp 2 bvalid 1 bready 1 araddr 34 arlen 4 arsize 3 arburst 2
       arvalid 1 arready 1 rdata 256 rresp 2 rlast 1 rvalid 1 rready 1}
  }
}
# signals that may be absent from the wrapper (the CL ties or ignores them)
proc otpu_sc_optional {} { return {C {awid arid bid rid} X {}} }

# the wrapper's ports: {name dir width} from its Verilog declarations ("input [33:0]X;")
proc otpu_sc_ports {text} {
  set ports {}
  foreach line [split $text "\n"] {
    if {[regexp {^\s*(input|output)\s*(?:wire\s*)?(?:\[(\d+):0\])?\s*([A-Za-z_][A-Za-z0-9_]*)\s*;} $line -> dir msb name]} {
      lappend ports [list $name $dir [expr {$msb eq "" ? 1 : $msb + 1}]]
    }
  }
  return $ports
}

proc otpu_sc_instance {text nport} {
  set w [otpu_sc_widths]
  set opt [otpu_sc_optional]
  set tie {lock cache prot qos region user}
  set clocks {core_clk clk hbm_clk hclk aresetn sc_aresetn}
  set conns {}
  set wires {}
  set seen {}
  set xid {}
  foreach p [otpu_sc_ports $text] {
    lassign $p name dir width
    set c ""
    if {[dict exists $clocks $name]} {
      if {$dir ne "input" || $width != 1} { error "openTPU SmartConnect: $name is not a one-bit input" }
      set c [dict get $clocks $name]
    } elseif {[regexp {^(S_N(\d+)|M_H(\d+))_([a-z]+)$} $name -> intf ns nm sig]} {
      set fam [expr {$ns ne "" ? "C" : "X"}]
      set k [expr {$ns ne "" ? $ns : $nm}]
      if {$k >= $nport} { error "openTPU SmartConnect: $name past NPORT $nport" }
      set pre [dict get {C cs X cm} $fam]
      set clsig "${pre}_$sig\[$k\]"
      set optional 0
      foreach t $tie { if {[string match *$t $sig]} { set optional 1 } }
      if {[dict exists [dict get $w $fam] $sig] || ($fam eq "X" && $sig in {awid arid rid bid})} {
        set want [expr {[dict exists [dict get $w $fam] $sig] ? [dict get [dict get $w $fam] $sig] : 6}]
        set adapt [expr {$sig in {awaddr araddr awid arid bid rid}}]
        if {$width != $want && !$adapt} { error "openTPU SmartConnect: $name is $width bits, the CL's $want" }
        if {$width == $want} {
          set c $clsig
        } elseif {$dir eq "input"} {
          set c "${width}'($clsig)"
        } else {
          lappend wires "logic \[[expr {$width - 1}]:0\] sc_$name;"
          lappend wires "assign $clsig = ${want}'(sc_$name);"
          set c "sc_$name"
        }
        lappend seen "$fam$k.$sig"
        if {$fam eq "X" && $sig in {awid arid}} { dict set xid "$k.$sig" 1 }
      } elseif {$dir eq "output"} {
        set c ""
      } elseif {$optional} {
        set c "'0"
      } else {
        error "openTPU SmartConnect: the CL has no signal for input $name"
      }
    } elseif {$dir eq "output"} {
      set c ""
    } else {
      error "openTPU SmartConnect: unknown wrapper input $name"
    }
    lappend conns [list $name $c]
  }
  # every signal the CL drives or reads, on every channel
  foreach fam {C X} intf {S_N M_H} {
    for {set k 0} {$k < $nport} {incr k} {
      foreach sig [dict keys [dict get $w $fam]] {
        if {"$fam$k.$sig" ni $seen && $sig ni [dict get $opt $fam]} {
          error "openTPU SmartConnect: the wrapper has no ${intf}${k}_$sig"
        }
      }
    }
  }
  set out "// Generated by boards/f2/build/scripts/create_hbm_sc.tcl from otpu_hbm_sc_wrapper's ports.\n"
  foreach l $wires { if {[string match logic* $l]} { append out $l "\n" } }
  append out "otpu_hbm_sc_wrapper u_sc (\n"
  set items {}
  foreach c $conns {
    lassign $c name conn
    lappend items "  .$name\($conn\)"
  }
  append out [join $items ",\n"] "\n);\n"
  foreach l $wires { if {[string match assign* $l]} { append out $l "\n" } }
  for {set k 0} {$k < $nport} {incr k} {
    foreach sig {awid arid} {
      if {![dict exists $xid "$k.$sig"]} { append out "assign cm_$sig\[$k\] = '0;\n" }
    }
    foreach sig {bid rid} {           # (the slice's responses' IDs, if the wrapper has none)
      if {"C$k.$sig" ni $seen} { append out "assign cs_$sig\[$k\] = '0;\n" }
    }
  }
  return $out
}
